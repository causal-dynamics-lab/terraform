# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# Optional SP auth (leave empty for az login / ARM_* env vars)
# azure_client_id     = ""
# azure_client_secret = ""

# environment feeds resource names + the globally-unique custom subdomain
environment = "staging"
# location  = "eastus2"

