[Unit]
Description=Olyvr backend (headless TeamMind host)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=olyvr
Group=olyvr
EnvironmentFile=/etc/olyvr/olyvr.env
Environment=PYTHONPATH=/opt/olyvr/src/rebuild/backend
WorkingDirectory=/var/lib/olyvr
ExecStart=/opt/olyvr/src/rebuild/.venv/bin/python /opt/olyvr/src/rebuild/scripts/backend-entry.py --port 9420 --state /var/lib/olyvr/state
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
