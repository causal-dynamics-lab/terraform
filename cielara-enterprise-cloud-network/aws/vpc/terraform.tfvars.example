# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

# --- AWS ----------------------------------------------------------------------
# Credentials come from the standard AWS chain (env vars, AWS_PROFILE, SSO) —
# nothing to put here.
region = "us-east-1"

# --- Ownership / naming -------------------------------------------------------
# Optional: tags the network with your Cielara client ID for identification.
# Leave unset if you don't have one yet.
# cielara_client_id = "<client id Cielara gave you>"
# name_prefix       = "cielara"

# --- Network sizing -----------------------------------------------------------
# Default is 10.2.0.0/20. Must be /20 or larger.
# vpc_cidr = "10.2.0.0/20"

# --- Placement / resilience ---------------------------------------------------
# Leave unset to use the region's first two AZs.
# availability_zones = ["us-east-1a", "us-east-1b"]
# One NAT per AZ instead of a single shared NAT (costlier, survives AZ outage).
# ha_nat = false
